<?xml version="1.0" encoding="UTF-8"?>

<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>Lecture Notes App</display-name>

    <welcome-file-list>
        <welcome-file>jsp/login.jsp</welcome-file>
    </welcome-file-list>

    <!-- FILTERS-->
    <!-- Filter order is the declaration order of the <filter-mapping>
         elements below: the character-encoding filter runs first (so request
         parameters are decoded as UTF-8 before anyone reads them), then the
         authentication filter guards every protected resource. -->

    <!-- Forces UTF-8 on requests and responses application-wide. -->
    <filter>
        <filter-name>CharacterEncodingFilter</filter-name>
        <filter-class>filter.CharacterEncodingFilter</filter-class>
        <init-param>
            <param-name>encoding</param-name>
            <param-value>UTF-8</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>CharacterEncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Requires an authenticated user in the HttpSession for every resource
         that is not explicitly public (see AuthenticationFilter). -->
    <filter>
        <filter-name>AuthenticationFilter</filter-name>
        <filter-class>filter.AuthenticationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Reference to the container-managed PostgreSQL connection pool
         declared in META-INF/context.xml -->
    <resource-ref>
        <description>Connection pool to the PostgreSQL database</description>
        <res-ref-name>jdbc/lecturenotes</res-ref-name>
        <res-type>javax.sql.DataSource</res-type>
        <res-auth>Container</res-auth>
    </resource-ref>

</web-app>